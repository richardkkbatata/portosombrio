// Configuração do site na Cloudflare (Worker com arquivos estáticos).
// site/ = as páginas; worker/index.js = só a rota /api/ranking (o resto vai direto pros arquivos).
{
  "name": "porto-sombrio",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/ws", "/health"]
  },
  // multiplayer: as salas ficam num Durable Object (grátis no plano Free, tipo SQLite)
  "durable_objects": { "bindings": [{ "name": "SALAS", "class_name": "Salas" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Salas"] }]
  // ranking: depois de criar o KV "ranking" na Cloudflare, cole o ID aqui:
  // ,"kv_namespaces": [{ "binding": "RANKING", "id": "COLE_O_ID_AQUI" }]
}
