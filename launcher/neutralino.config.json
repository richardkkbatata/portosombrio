{
  "applicationId": "br.net.nightgetaway.launcher",
  "version": "2.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "nativeAllowList": [
    "app.exit",
    "app.killProcess",
    "window.setTitle",
    "window.minimize",
    "os.getEnv",
    "os.execCommand",
    "filesystem.readFile",
    "filesystem.writeFile",
    "filesystem.readBinaryFile",
    "filesystem.writeBinaryFile",
    "filesystem.copy",
    "filesystem.createDirectory",
    "filesystem.remove",
    "filesystem.move",
    "filesystem.getStats"
  ],
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "modes": {
    "window": {
      "title": "NightGetaway",
      "width": 1080,
      "height": 760,
      "minWidth": 720,
      "minHeight": 520,
      "fullScreen": false,
      "center": true,
      "resizable": true,
      "enableInspector": false,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "NightGetaway",
    "resourcesPath": "/resources/"
  }
}
