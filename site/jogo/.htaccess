# Gerado por ferramentas/integrar.py — NÃO edite à mão.
# A política abaixo libera só os scripts desta versão exata do jogo (hash sha256)
# e o necessário do Google (AdSense / H5 Games Ads).
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-JQ8hi+XTqjw6szptqdLRRA/VzV6AnQi7RdiA1j5An6E=' 'sha256-d5C0cQbECzub2KQ6OVzIHA3a5DKQ+yfcb4sbAh7TMsg=' https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.google.com https://*.gstatic.com https://*.doubleclick.net https://*.googletagservices.com https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://nightgetaway.net.br wss://nightgetaway.net.br https://*.onrender.com wss://*.onrender.com wss://0.peerjs.com wss://broker.emqx.io:8084 wss://broker.hivemq.com:8884 https://cloudflareinsights.com https://*.google.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://*.gstatic.com; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
